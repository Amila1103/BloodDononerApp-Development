<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="15dp"
    app:cardElevation="0dp"
    app:strokeColor="#E8E8E8"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="15dp">


        <!-- TYPE / STATUS -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="EMERGENCY BLOOD REQUEST"
                android:textColor="#EF2637"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtRequestStatus"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/bg_status_pending"
                android:gravity="center"
                android:paddingStart="11dp"
                android:paddingEnd="11dp"
                android:text="Pending"
                android:textColor="#D97706"
                android:textSize="10sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- BLOOD GROUP / HOSPITAL -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtRequestBloodGroup"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/bg_blood_badge"
                android:gravity="center"
                android:text="-"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtRequestHospital"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Hospital"
                    android:textColor="#111111"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtRequestLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="-"
                    android:textColor="#777777"
                    android:textSize="10sp" />

            </LinearLayout>

        </LinearLayout>


        <!-- REQUEST INFO -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:background="#FFF7F7"
            android:orientation="horizontal"
            android:padding="12dp">

            <!-- UNITS -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Units"
                    android:textColor="#777777"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/txtRequestUnits"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="-"
                    android:textColor="#111111"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- REQUIRED -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Required"
                    android:textColor="#777777"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/txtRequestRequired"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="-"
                    android:textColor="#111111"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- URGENCY -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Urgency"
                    android:textColor="#777777"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/txtRequestUrgency"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="-"
                    android:textColor="#EF2637"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>


        <!-- BUTTONS -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBloodRequestDetails"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="View Details"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                app:backgroundTint="#EF2637"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelRequest"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="Cancel"
                android:textAllCaps="false"
                android:textColor="#EF2637"
                android:textSize="10sp"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="10dp"
                app:strokeColor="#FFD6DA"
                app:strokeWidth="1dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>