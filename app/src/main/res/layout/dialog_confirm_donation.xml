<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:padding="22dp">

    <!-- ICON -->

    <TextView
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_confirm_icon"
        android:gravity="center"
        android:text="♥"
        android:textColor="#EF2637"
        android:textSize="28sp" />

    <!-- TITLE -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="Confirm Donation Appointment"
        android:textColor="#111111"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center"
        android:text="Please review your appointment before confirming."
        android:textColor="#777777"
        android:textSize="11sp" />


    <!-- HOSPITAL CARD -->

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:cardBackgroundColor="#FFF1F2"
        app:cardCornerRadius="13dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_hospital_icon"
                android:gravity="center"
                android:text="✚"
                android:textColor="#EF2637"
                android:textSize="19sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="11dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtConfirmHospital"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="National Blood Bank"
                    android:textColor="#111111"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtConfirmLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Colombo"
                    android:textColor="#777777"
                    android:textSize="10sp" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>


    <!-- DETAILS TITLE -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="APPOINTMENT DETAILS"
        android:textColor="#777777"
        android:textSize="10sp"
        android:textStyle="bold" />


    <!-- BLOOD GROUP -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Blood Group"
            android:textColor="#555555"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/txtConfirmBloodGroup"
            android:layout_width="48dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_blood_badge"
            android:gravity="center"
            android:text="B+"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EEEEEE" />


    <!-- DATE -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Date"
            android:textColor="#555555"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/txtConfirmDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="30 Sep 2026"
            android:textColor="#111111"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EEEEEE" />


    <!-- TIME -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Time"
            android:textColor="#555555"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/txtConfirmTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10:00 AM - 12:00 PM"
            android:textColor="#111111"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>


    <!-- MEDICAL INFORMATION -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_medical_note"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:gravity="center"
            android:text="!"
            android:textColor="#EF2637"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:text="Final donor eligibility will be confirmed by medical staff at the donation center."
            android:textColor="#666666"
            android:textSize="10sp"
            android:lineSpacingExtra="2dp" />

    </LinearLayout>


    <!-- CONFIRM -->

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirmAppointment"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:text="Confirm Appointment"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        app:backgroundTint="#EF2637"
        app:cornerRadius="11dp" />


    <!-- EDIT -->

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEditAppointment"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:text="Edit Appointment"
        android:textAllCaps="false"
        android:textColor="#EF2637"
        android:textSize="12sp"
        android:textStyle="bold"
        app:backgroundTint="#FFFFFF"
        app:cornerRadius="11dp"
        app:strokeColor="#FFD5D9"
        app:strokeWidth="1dp" />

</LinearLayout>