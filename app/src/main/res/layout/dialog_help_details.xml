<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_help_dialog"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_help_icon_large"
        android:gravity="center"
        android:text="♥"
        android:textColor="#EF2637"
        android:textSize="27sp" />

    <TextView
        android:id="@+id/txtHelpDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="Help"
        android:textColor="#111111"
        android:textSize="18sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:scrollbars="none">

        <TextView
            android:id="@+id/txtHelpDialogContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_help_content"
            android:lineSpacingExtra="4dp"
            android:padding="15dp"
            android:textColor="#555555"
            android:textSize="11sp" />

    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCloseHelp"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="18dp"
        android:text="Close"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        app:backgroundTint="#EF2637"
        app:cornerRadius="11dp" />

</LinearLayout>