<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_details_dialog"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ICON -->

        <TextView
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_detail_header_icon"
            android:gravity="center"
            android:text="♥"
            android:textColor="#EF2637"
            android:textSize="29sp" />

        <!-- TITLE -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:gravity="center"
            android:text="Donation Appointment"
            android:textColor="#111111"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- ID -->

        <TextView
            android:id="@+id/txtDonationAppointmentId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Appointment #DA-2026-001"
            android:textColor="#777777"
            android:textSize="10sp" />

        <!-- STATUS -->

        <TextView
            android:id="@+id/txtDonationDetailStatus"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_status_confirmed"
            android:gravity="center"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:text="✓  CONFIRMED"
            android:textColor="#15803D"
            android:textSize="10sp"
            android:textStyle="bold" />


        <!-- HOSPITAL CARD -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="#FFF1F2"
            app:cardCornerRadius="13dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="13dp">

                <TextView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_hospital_icon"
                    android:gravity="center"
                    android:text="✚"
                    android:textColor="#EF2637"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="11dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtDonationDetailHospital"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="National Blood Bank"
                        android:textColor="#111111"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtDonationDetailLocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Colombo"
                        android:textColor="#777777"
                        android:textSize="10sp" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- APPOINTMENT DETAILS -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="APPOINTMENT DETAILS"
            android:textColor="#777777"
            android:textSize="10sp"
            android:textStyle="bold" />


        <!-- BLOOD GROUP -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Blood Group"
                android:textColor="#555555"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/txtDonationDetailBloodGroup"
                android:layout_width="48dp"
                android:layout_height="30dp"
                android:background="@drawable/bg_blood_badge"
                android:gravity="center"
                android:text="B+"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EEEEEE" />


        <!-- DATE -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Appointment Date"
                android:textColor="#555555"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/txtDonationDetailDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="30 Sep 2026"
                android:textColor="#111111"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EEEEEE" />


        <!-- TIME -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Appointment Time"
                android:textColor="#555555"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/txtDonationDetailTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10:00 AM - 12:00 PM"
                android:textColor="#111111"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- ELIGIBILITY -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="ELIGIBILITY"
            android:textColor="#777777"
            android:textSize="10sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_eligibility_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_eligibility_icon"
                android:gravity="center"
                android:text="✓"
                android:textColor="#15803D"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Preliminary Screening Completed"
                    android:textColor="#166534"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Final eligibility will be confirmed at the donation center."
                    android:textColor="#4B7B59"
                    android:textSize="9sp" />

            </LinearLayout>

        </LinearLayout>


        <!-- IMPORTANT -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:text="IMPORTANT INFORMATION"
            android:textColor="#777777"
            android:textSize="10sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_medical_note"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:gravity="center"
                android:text="!"
                android:textColor="#EF2637"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:lineSpacingExtra="2dp"
                android:text="Please arrive at the donation center at your scheduled time. Final donor eligibility and approval will be confirmed by qualified medical staff before donation."
                android:textColor="#666666"
                android:textSize="9sp" />

        </LinearLayout>


        <!-- CLOSE -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCloseDonationDetails"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="18dp"
            android:text="Close"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            app:backgroundTint="#EF2637"
            app:cornerRadius="11dp" />

    </LinearLayout>

</ScrollView>