<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- ============================= -->
    <!-- TOP BAR -->
    <!-- ============================= -->

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="88dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="#222222"
            android:textSize="32sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Donors Near You"
                android:textColor="#1F1F1F"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Find available blood donors nearby"
                android:textColor="#8A8A8A"
                android:textSize="10sp" />

        </LinearLayout>

        <View
            android:layout_width="42dp"
            android:layout_height="42dp" />

    </LinearLayout>


    <!-- ============================= -->
    <!-- CONTENT -->
    <!-- ============================= -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/resultsScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">


            <!-- ============================= -->
            <!-- FILTERS -->
            <!-- ============================= -->

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipBloodGroup"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:text="O+"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        app:chipBackgroundColor="#EF2637"
                        app:chipCornerRadius="19dp"
                        app:closeIconEnabled="true"
                        app:closeIconTint="#FFFFFF" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipDistance"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginStart="8dp"
                        android:text="Within 10 km"
                        android:textColor="#333333"
                        android:textSize="11sp"
                        app:chipBackgroundColor="#FFFFFF"
                        app:chipCornerRadius="19dp"
                        app:chipStrokeColor="#DADADA"
                        app:chipStrokeWidth="1dp"
                        app:closeIconEnabled="true"
                        app:closeIconTint="#777777" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFilter"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="8dp"
                        android:contentDescription="Filter"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="10dp"
                        app:backgroundTint="#FFFFFF"
                        app:cornerRadius="21dp"
                        app:icon="@drawable/ic_filter"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconSize="19dp"
                        app:iconTint="#333333"
                        app:strokeColor="#DADADA"
                        app:strokeWidth="1dp" />

                </LinearLayout>

            </HorizontalScrollView>


            <!-- ============================= -->
            <!-- RESULTS COUNT -->
            <!-- ============================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtResultsCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Searching donors..."
                    android:textColor="#555555"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtSort"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="Sort: Available ▾"
                    android:textColor="#EF2637"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- ============================= -->
            <!-- DYNAMIC DONOR LIST -->
            <!-- ============================= -->

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerDonors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />


            <!-- ============================= -->
            <!-- NO RESULTS -->
            <!-- ============================= -->

            <LinearLayout
                android:id="@+id/noResultsContainer"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No donors found"
                    android:textColor="#222222"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="Try changing the blood group, location or distance."
                    android:textColor="#888888"
                    android:textSize="10sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnChangeFilters"
                    android:layout_width="150dp"
                    android:layout_height="44dp"
                    android:layout_marginTop="18dp"
                    android:text="Change Filters"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:backgroundTint="#EF2637"
                    app:cornerRadius="12dp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>


    <!-- ============================= -->
    <!-- BOTTOM NAVIGATION -->
    <!-- ============================= -->

    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <!-- HOME -->

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Home"
                android:src="@drawable/ic_nav_home"
                app:tint="#777777" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Home"
                android:textColor="#777777"
                android:textSize="8sp" />

        </LinearLayout>


        <!-- SEARCH -->

        <LinearLayout
            android:id="@+id/navSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Search"
                android:src="@drawable/ic_nav_search"
                app:tint="#EF2637" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Search"
                android:textColor="#EF2637"
                android:textSize="8sp" />

        </LinearLayout>


        <!-- REQUESTS -->

        <LinearLayout
            android:id="@+id/navRequests"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Requests"
                android:src="@drawable/ic_nav_requests"
                app:tint="#777777" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Requests"
                android:textColor="#777777"
                android:textSize="8sp" />

        </LinearLayout>


        <!-- NOTIFICATIONS -->

        <LinearLayout
            android:id="@+id/navNotifications"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Notifications"
                android:src="@drawable/ic_home_notification"
                app:tint="#777777" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Notifications"
                android:textColor="#777777"
                android:textSize="7sp" />

        </LinearLayout>


        <!-- PROFILE -->

        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Profile"
                android:src="@drawable/ic_nav_profile"
                app:tint="#777777" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Profile"
                android:textColor="#777777"
                android:textSize="8sp" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>