<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardNotification"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#FFF1F3"
    app:cardCornerRadius="17dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="17dp">


        <!-- ================================================= -->
        <!-- ICON -->
        <!-- ================================================= -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/iconBackground"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardBackgroundColor="#EF2637"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/imgIcon"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_gravity="center"
                android:contentDescription="Notification icon"
                android:src="@drawable/ic_staff_emergency"
                app:tint="#FFFFFF" />

        </com.google.android.material.card.MaterialCardView>


        <!-- ================================================= -->
        <!-- TEXT -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">


            <TextView
                android:id="@+id/txtTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Notification"
                android:textColor="#222222"
                android:textSize="12sp"
                android:textStyle="bold" />


            <TextView
                android:id="@+id/txtMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="3"
                android:text="Notification message"
                android:textColor="#777777"
                android:textSize="9sp" />


            <TextView
                android:id="@+id/txtTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Just now"
                android:textColor="#999999"
                android:textSize="8sp" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- UNREAD DOT -->
        <!-- ================================================= -->

        <View
            android:id="@+id/unreadIndicator"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_staff_blood_circle" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>