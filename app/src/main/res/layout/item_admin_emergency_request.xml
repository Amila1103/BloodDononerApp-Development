<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardRequest"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="17dp"
    app:cardElevation="0dp"
    app:strokeColor="#EAEAEA"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="17dp">


        <!-- BLOOD GROUP -->

        <FrameLayout
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:background="@drawable/bg_staff_blood_circle">

            <TextView
                android:id="@+id/txtItemBloodGroup"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="A+"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

        </FrameLayout>


        <!-- REQUEST INFORMATION -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtItemRequestId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REQ-00000000"
                android:textColor="#222222"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtItemHospital"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Hospital"
                android:textColor="#777777"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/txtItemStatusUnits"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Pending • 2 Units"
                android:textColor="#EF2637"
                android:textSize="9sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- ARROW -->

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_staff_arrow_right"
            app:tint="#EF2637" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>