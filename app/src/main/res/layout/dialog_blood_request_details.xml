<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_details_dialog"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ICON -->

        <TextView
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_detail_header_icon"
            android:gravity="center"
            android:text="♥"
            android:textColor="#EF2637"
            android:textSize="29sp" />

        <!-- TITLE -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:gravity="center"
            android:text="Blood Request Details"
            android:textColor="#111111"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtRequestDetailId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Request #BR-2026-001"
            android:textColor="#777777"
            android:textSize="10sp" />

        <!-- STATUS -->

        <TextView
            android:id="@+id/txtRequestDetailStatus"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_status_pending"
            android:gravity="center"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:text="●  PENDING"
            android:textColor="#D97706"
            android:textSize="10sp"
            android:textStyle="bold" />


        <!-- HOSPITAL -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="#FFF1F2"
            app:cardCornerRadius="13dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="13dp">

                <TextView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_hospital_icon"
                    android:gravity="center"
                    android:text="✚"
                    android:textColor="#EF2637"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="11dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtRequestDetailHospital"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="National Blood Bank"
                        android:textColor="#111111"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtRequestDetailLocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Colombo"
                        android:textColor="#777777"
                        android:textSize="10sp" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- REQUEST DETAILS -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="REQUEST DETAILS"
            android:textColor="#777777"
            android:textSize="10sp"
            android:textStyle="bold" />


        <!-- BLOOD GROUP -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Blood Group"
                android:textColor="#555555"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/txtRequestDetailBloodGroup"
                android:layout_width="48dp"
                android:layout_height="30dp"
                android:background="@drawable/bg_blood_badge"
                android:gravity="center"
                android:text="O+"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EEEEEE" />


        <!-- UNITS -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Units Required"
                android:textColor="#555555"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/txtRequestDetailUnits"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2 Units"
                android:textColor="#111111"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EEEEEE" />


        <!-- DATE -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Required Date"
                android:textColor="#555555"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/txtRequestDetailDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="28 Sep 2026"
                android:textColor="#111111"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EEEEEE" />


        <!-- BEFORE -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Required Before"
                android:textColor="#555555"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/txtRequestDetailBefore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="6:00 PM"
                android:textColor="#111111"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EEEEEE" />


        <!-- URGENCY -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Urgency"
                android:textColor="#555555"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/txtRequestDetailUrgency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="URGENT"
                android:textColor="#EF2637"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- CONTACT -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="CONTACT"
            android:textColor="#777777"
            android:textSize="10sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_detail_info_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Primary Contact"
                android:textColor="#666666"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/txtRequestDetailContact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="07X XXX XXXX"
                android:textColor="#111111"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- REQUEST STATUS -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:text="REQUEST STATUS"
            android:textColor="#777777"
            android:textSize="10sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_request_status_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:gravity="center"
                android:text="●"
                android:textColor="#D97706"
                android:textSize="14sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="Waiting for a matching donor or blood bank response."
                android:textColor="#75541C"
                android:textSize="10sp" />

        </LinearLayout>


        <!-- CLOSE -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCloseRequestDetails"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="18dp"
            android:text="Close"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            app:backgroundTint="#EF2637"
            app:cornerRadius="11dp" />

    </LinearLayout>

</ScrollView>