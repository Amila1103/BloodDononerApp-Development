<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- =============================== -->
    <!-- HEADER -->
    <!-- =============================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="‹"
            android:textColor="#111111"
            android:textSize="32sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Blood Banks &amp; Donation Centers"
            android:textColor="#111111"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="40dp"
            android:layout_height="40dp" />

    </LinearLayout>


    <!-- =============================== -->
    <!-- CONTENT -->
    <!-- =============================== -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="30dp">


            <!-- SEARCH -->

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="#E4E4E4"
                app:hintEnabled="false">

                <EditText
                    android:id="@+id/searchInput"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="Search hospital, blood bank or area"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:singleLine="true"
                    android:textColor="#111111"
                    android:textColorHint="#8B8B8B"
                    android:textSize="13sp" />

            </com.google.android.material.textfield.TextInputLayout>


            <!-- BLOOD GROUP -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Blood Group"
                android:textColor="#111111"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Select a blood group to check availability and donor needs"
                android:textColor="#777777"
                android:textSize="10sp" />


            <!-- BLOOD GROUP CHIPS -->

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnBloodAll"
                        android:layout_width="52dp"
                        android:layout_height="38dp"
                        android:layout_marginEnd="7dp"
                        android:background="@drawable/bg_blood_group_normal"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="All"
                        android:textColor="#111111"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnAPlus"
                        android:layout_width="52dp"
                        android:layout_height="38dp"
                        android:layout_marginEnd="7dp"
                        android:background="@drawable/bg_blood_group_normal"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="A+"
                        android:textColor="#111111"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnAMinus"
                        android:layout_width="52dp"
                        android:layout_height="38dp"
                        android:layout_marginEnd="7dp"
                        android:background="@drawable/bg_blood_group_normal"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="A-"
                        android:textColor="#111111"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnBPlus"
                        android:layout_width="52dp"
                        android:layout_height="38dp"
                        android:layout_marginEnd="7dp"
                        android:background="@drawable/bg_blood_group_normal"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="B+"
                        android:textColor="#111111"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnBMinus"
                        android:layout_width="52dp"
                        android:layout_height="38dp"
                        android:layout_marginEnd="7dp"
                        android:background="@drawable/bg_blood_group_normal"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="B-"
                        android:textColor="#111111"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnABPlus"
                        android:layout_width="52dp"
                        android:layout_height="38dp"
                        android:layout_marginEnd="7dp"
                        android:background="@drawable/bg_blood_group_normal"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="AB+"
                        android:textColor="#111111"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnABMinus"
                        android:layout_width="52dp"
                        android:layout_height="38dp"
                        android:layout_marginEnd="7dp"
                        android:background="@drawable/bg_blood_group_normal"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="AB-"
                        android:textColor="#111111"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnOPlus"
                        android:layout_width="52dp"
                        android:layout_height="38dp"
                        android:layout_marginEnd="7dp"
                        android:background="@drawable/bg_blood_group_normal"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="O+"
                        android:textColor="#111111"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnOMinus"
                        android:layout_width="52dp"
                        android:layout_height="38dp"
                        android:layout_marginEnd="7dp"
                        android:background="@drawable/bg_blood_group_normal"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="O-"
                        android:textColor="#111111"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </HorizontalScrollView>


            <!-- NEARBY / ALL -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_tab_container"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/btnNearby"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Nearby"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnAll"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="All"
                    android:textColor="#777777"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- INFORMATION -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="#FFF1F2"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="For recipients"
                    android:textColor="#EF2637"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Check blood availability and create an emergency blood request."
                    android:textColor="#777777"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="For donors"
                    android:textColor="#EF2637"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="See which blood groups are currently needed and find a donation center."
                    android:textColor="#777777"
                    android:textSize="10sp" />

            </LinearLayout>


            <!-- BANK CARDS -->

            <LinearLayout
                android:id="@+id/bankContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>