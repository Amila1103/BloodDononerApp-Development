<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">


        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:gravity="center"
                android:text="‹"
                android:textColor="#222222"
                android:textSize="30sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Request Details"
                    android:textColor="#111111"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtRequestId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="REQ-00000000"
                    android:textColor="#888888"
                    android:textSize="10sp" />

            </LinearLayout>

        </LinearLayout>


        <!-- ================================================= -->
        <!-- BLOOD INFORMATION CARD -->
        <!-- ================================================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="145dp"
            android:layout_marginTop="22dp"
            app:cardBackgroundColor="#EF2637"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="20dp">

                <!-- BLOOD GROUP CIRCLE -->

                <FrameLayout
                    android:layout_width="75dp"
                    android:layout_height="75dp"
                    android:background="@drawable/bg_staff_white_circle">

                    <TextView
                        android:id="@+id/txtBloodGroup"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="A+"
                        android:textColor="#EF2637"
                        android:textSize="23sp"
                        android:textStyle="bold" />

                </FrameLayout>


                <!-- UNITS -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Units Required"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/txtUnits"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="2 Units"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ================================================= -->
        <!-- REQUEST INFORMATION TITLE -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Request Information"
            android:textColor="#222222"
            android:textSize="15sp"
            android:textStyle="bold" />


        <!-- ================================================= -->
        <!-- REQUEST INFORMATION CARD -->
        <!-- ================================================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="#FFF1F3"
            app:cardCornerRadius="17dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">


                <!-- ========================================= -->
                <!-- PATIENT / REQUESTER -->
                <!-- ========================================= -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Patient / Requester"
                    android:textColor="#888888"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/txtPatient"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Requester"
                    android:textColor="#222222"
                    android:textSize="13sp"
                    android:textStyle="bold" />


                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp"
                    android:background="#FFDDE2" />


                <!-- ========================================= -->
                <!-- HOSPITAL -->
                <!-- ========================================= -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hospital / Blood Bank"
                    android:textColor="#888888"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/txtHospital"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Hospital"
                    android:textColor="#222222"
                    android:textSize="13sp"
                    android:textStyle="bold" />


                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp"
                    android:background="#FFDDE2" />


                <!-- ========================================= -->
                <!-- LOCATION -->
                <!-- ========================================= -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Location"
                    android:textColor="#888888"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/txtLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Location"
                    android:textColor="#222222"
                    android:textSize="13sp"
                    android:textStyle="bold" />


                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp"
                    android:background="#FFDDE2" />


                <!-- ========================================= -->
                <!-- REQUIRED DATE -->
                <!-- ========================================= -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Required Date"
                    android:textColor="#888888"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/txtRequiredDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Date"
                    android:textColor="#222222"
                    android:textSize="13sp"
                    android:textStyle="bold" />


                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp"
                    android:background="#FFDDE2" />


                <!-- ========================================= -->
                <!-- REQUIRED BEFORE -->
                <!-- ========================================= -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Required Before"
                    android:textColor="#888888"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/txtRequiredBefore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Time"
                    android:textColor="#222222"
                    android:textSize="13sp"
                    android:textStyle="bold" />


                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp"
                    android:background="#FFDDE2" />


                <!-- ========================================= -->
                <!-- PRIMARY CONTACT -->
                <!-- ========================================= -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Primary Contact"
                    android:textColor="#888888"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/txtPrimaryContact"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Contact"
                    android:textColor="#222222"
                    android:textSize="13sp"
                    android:textStyle="bold" />


                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp"
                    android:background="#FFDDE2" />


                <!-- ========================================= -->
                <!-- SECONDARY CONTACT -->
                <!-- ========================================= -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Secondary Contact"
                    android:textColor="#888888"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/txtSecondaryContact"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Not provided"
                    android:textColor="#222222"
                    android:textSize="13sp"
                    android:textStyle="bold" />


                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp"
                    android:background="#FFDDE2" />


                <!-- ========================================= -->
                <!-- URGENCY -->
                <!-- ========================================= -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Urgency"
                    android:textColor="#888888"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/txtUrgency"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Urgent"
                    android:textColor="#EF2637"
                    android:textSize="13sp"
                    android:textStyle="bold" />


                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp"
                    android:background="#FFDDE2" />


                <!-- ========================================= -->
                <!-- CURRENT STATUS -->
                <!-- ========================================= -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Current Status"
                    android:textColor="#888888"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/txtStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Pending"
                    android:textColor="#15803D"
                    android:textSize="13sp"
                    android:textStyle="bold" />


                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp"
                    android:background="#FFDDE2" />


                <!-- ========================================= -->
                <!-- ADDITIONAL INFORMATION -->
                <!-- ========================================= -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Additional Information"
                    android:textColor="#888888"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/txtAdditionalInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="No additional information"
                    android:textColor="#222222"
                    android:textSize="13sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ================================================= -->
        <!-- REQUEST ACTIONS -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Request Actions"
            android:textColor="#222222"
            android:textSize="15sp"
            android:textStyle="bold" />


        <!-- ================================================= -->
        <!-- START MATCHING -->
        <!-- ================================================= -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartMatching"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"
            android:text="Start Matching"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="#2563EB"
            app:cornerRadius="14dp" />


        <!-- ================================================= -->
        <!-- MARK AS FULFILLED -->
        <!-- ================================================= -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMarkFulfilled"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="10dp"
            android:text="Mark as Fulfilled"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="#15803D"
            app:cornerRadius="14dp" />


        <!-- ================================================= -->
        <!-- ADMIN INFORMATION -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="25dp"
            android:background="@drawable/bg_staff_filter"
            android:padding="15dp"
            android:text="Admin view is for system monitoring. Request verification and donor matching are handled by authorized hospital staff."
            android:textColor="#777777"
            android:textSize="10sp" />

    </LinearLayout>

</ScrollView>