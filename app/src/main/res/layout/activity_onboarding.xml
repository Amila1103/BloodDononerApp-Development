<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/onboardingMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_white"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    tools:context=".OnboardingActivity">

    <!-- Skip -->

    <TextView
        android:id="@+id/txtSkip"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="4dp"
        android:text="Skip"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <!-- Main content -->

    <LinearLayout
        android:id="@+id/contentContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/btnNext"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtSkip"
        app:layout_constraintVertical_bias="0.32">


        <!-- Image -->

        <ImageView
            android:id="@+id/imgOnboarding"
            android:layout_width="245dp"
            android:layout_height="245dp"
            android:contentDescription="Onboarding Illustration"
            android:scaleType="fitCenter"
            android:src="@drawable/onboarding_donate" />


        <!-- Title -->

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="Donate Blood, Save Lives"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />


        <!-- Description -->

        <TextView
            android:id="@+id/txtDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginTop="9dp"
            android:layout_marginEnd="18dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="Give blood and bring hope to someone in need."
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />


        <!-- Dots -->

        <LinearLayout
            android:id="@+id/pageIndicator"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginTop="26dp"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:id="@+id/dot1"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:background="@drawable/dot_active" />

            <View
                android:id="@+id/dot2"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/dot_inactive" />

            <View
                android:id="@+id/dot3"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/dot_inactive" />

        </LinearLayout>

    </LinearLayout>


    <!-- Next Button -->

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNext"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="36dp"
        android:text="Next"
        android:textAllCaps="false"
        android:textColor="@color/background_white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="@color/blood_red"
        app:cornerRadius="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>