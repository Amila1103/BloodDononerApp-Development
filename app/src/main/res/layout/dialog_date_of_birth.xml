<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/background_white"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="22dp"
    android:paddingEnd="22dp"
    android:paddingBottom="18dp">


    <!-- ========================================= -->
    <!-- TITLE -->
    <!-- ========================================= -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Date of Birth"
        android:textColor="@color/text_primary"
        android:textSize="21sp"
        android:textStyle="bold" />


    <!-- ========================================= -->
    <!-- DESCRIPTION -->
    <!-- ========================================= -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="Choose your day, month and year"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />


    <!-- ========================================= -->
    <!-- LABEL ROW -->
    <!-- ========================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">


        <!-- DAY LABEL -->

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Day"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />


        <!-- MONTH LABEL -->

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1.45"
            android:text="Month"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />


        <!-- YEAR LABEL -->

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1.1"
            android:text="Year"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>


    <!-- ========================================= -->
    <!-- DROPDOWN ROW -->
    <!-- ========================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">


        <!-- ========================================= -->
        <!-- DAY -->
        <!-- ========================================= -->

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            app:boxCornerRadiusBottomEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusTopStart="10dp"
            app:boxStrokeColor="@color/border_light"
            app:hintEnabled="false">

            <AutoCompleteTextView
                android:id="@+id/dropDay"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:hint="Day"
                android:inputType="none"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="4dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="13sp" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- ========================================= -->
        <!-- MONTH -->
        <!-- ========================================= -->

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1.45"
            app:boxCornerRadiusBottomEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusTopStart="10dp"
            app:boxStrokeColor="@color/border_light"
            app:hintEnabled="false">

            <AutoCompleteTextView
                android:id="@+id/dropMonth"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:hint="Month"
                android:inputType="none"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="4dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="13sp" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- ========================================= -->
        <!-- YEAR -->
        <!-- ========================================= -->

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1.1"
            app:boxCornerRadiusBottomEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusTopStart="10dp"
            app:boxStrokeColor="@color/border_light"
            app:hintEnabled="false">

            <AutoCompleteTextView
                android:id="@+id/dropYear"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:hint="Year"
                android:inputType="none"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingEnd="4dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="13sp" />

        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>


    <!-- ========================================= -->
    <!-- ERROR MESSAGE -->
    <!-- ========================================= -->

    <TextView
        android:id="@+id/txtDateError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Please select a valid date"
        android:textColor="@color/blood_red"
        android:textSize="12sp"
        android:visibility="gone" />


    <!-- ========================================= -->
    <!-- BUTTONS -->
    <!-- ========================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">


        <!-- CANCEL -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelDate"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />


        <!-- SELECT -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSelectDate"
            android:layout_width="105dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:text="Select"
            android:textAllCaps="false"
            android:textColor="@color/background_white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@color/blood_red"
            app:cornerRadius="10dp" />

    </LinearLayout>

</LinearLayout>